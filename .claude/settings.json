{
  "permissions": {
    "allow": [
      "Bash(snow --version)",
      "Bash(snow connection list)",
      "Bash(snow stage list-files:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_git_writes.py\""
          }
        ]
      }
    ]
  }
}
